        "type": "Image"
      },
      "keywords": {
        "config": {
          "fields": {
            "word": {
              "config": {
                "label": "word",
                "placeholder": ""
              },
              "type": "Text"
            }
          },
          "label": "Keywords",
          "repeat": true
        },
        "type": "Group"
      },
      "slices1": {
        "config": {
          "choices": {}
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
