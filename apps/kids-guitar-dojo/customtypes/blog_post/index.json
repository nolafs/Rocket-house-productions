{
  "format": "page",
  "id": "blog_post",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID",
          "placeholder": ""
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Title",
          "placeholder": ""
        },
        "type": "Text"
      },
      "category": {
        "config": {
          "customtypes": [
            "blog_category"
          ],
          "label": "Category",
          "select": "document"
        },
        "type": "Link"
      },
      "publishing_date": {
        "config": {
          "label": "Publishing Date",
          "placeholder": ""
        },
        "type": "Date"
      },
      "feature_image": {
        "config": {
          "constraint": {},
          "label": "Feature Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "author": {
        "config": {
          "customtypes": [
            "author"
          ],
          "label": "Author",
          "select": "document"
        },
        "type": "Link"
      },
      "description": {
        "config": {
          "label": "Description ",
          "placeholder": ""
        },
        "type": "Text"
      },
      "main": {
        "config": {
          "allowTargetBlank": true,
          "label": "Body",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "tags": {
        "config": {
          "fields": {
            "tag": {
              "config": {
                "customtypes": [
                  "blog_tags"
                ],
                "label": "tag",
                "select": "document"
              },
              "type": "Link"
            }
          },
          "label": "Tags",
          "repeat": true
        },
        "type": "Group"
      },
      "slices": {
        "config": {
          "choices": {
            "rich_text_slice": {
              "type": "SharedSlice"
            },
            "faqs": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
