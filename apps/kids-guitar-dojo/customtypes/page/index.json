{
  "format": "page",
  "id": "page",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "allowTargetBlank": true,
          "label": "Title",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "parent": {
        "config": {
          "allowTargetBlank": false,
          "label": "Parent",
          "placeholder": "",
          "select": null
        },
        "type": "Link"
      },
      "slices": {
        "config": {
          "choices": {
            "faqs": {
              "type": "SharedSlice"
            },
            "pricing_table": {
              "type": "SharedSlice"
            },
            "testimonials": {
              "type": "SharedSlice"
            },
            "stats": {
              "type": "SharedSlice"
            },
            "timeline": {
              "type": "SharedSlice"
            },
            "features": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "section_headers": {
              "type": "SharedSlice"
            },
            "rich_text_slice": {
              "type": "SharedSlice"
            },
            "content_image_slice": {
              "type": "SharedSlice"
            },
            "discounts": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Page",
  "repeatable": true,
  "status": true
}